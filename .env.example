APP_ENV=dev
APP_NAME=day13-observability-lab
LOG_LEVEL=INFO
LOG_PATH=data/logs.jsonl
AUDIT_LOG_PATH=data/audit.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud có nhiều region; key chỉ hợp lệ đúng region đã tạo ra nó.
# EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com | JP: https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=day13-chat
LANGFUSE_PROMPT_LABEL=production

# LLM provider: fake (mặc định, chạy offline và miễn phí) hoặc openai (gọi API thật).
# Để fake khi chạy tests và khi cần kết quả tái lập cho bài chấm.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=180
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
